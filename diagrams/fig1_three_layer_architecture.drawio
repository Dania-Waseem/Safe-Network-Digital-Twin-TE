<mxfile host="make_diagrams.py"><diagram name="fig1_three_layer_architecture"><mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" page="1" pageScale="1" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="" style="rounded=1;arcSize=4;fillColor=#F4F9FE;strokeColor=#3F75B0;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="8.0" y="34.8" width="570.0" height="346.5" as="geometry"/></mxCell><mxCell id="3" value="" style="rounded=1;arcSize=4;fillColor=#F3FBF4;strokeColor=#3F8E4C;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="154.0" y="397.2" width="581.0" height="245.3" as="geometry"/></mxCell><mxCell id="4" value="" style="rounded=1;arcSize=4;fillColor=#FFF8F0;strokeColor=#D27A1F;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="651.0" y="658.5" width="558.0" height="271.5" as="geometry"/></mxCell><mxCell id="5" value="PHYSICAL / DATA LAYER" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;fillColor=#A9CBEF;strokeColor=#2B5C94;strokeWidth=1.4;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="379.9" y="42.8" width="190.2" height="36.0" as="geometry"/></mxCell><mxCell id="6" value="Teal repository&lt;br&gt;B4 real TMs · UsCarrier, Kdl (toy)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;fillColor=#DCEBFA;strokeColor=#3F75B0;strokeWidth=1.4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="16.3" y="110.8" width="201.4" height="42.9" as="geometry"/></mxCell><mxCell id="7" value="FIGRET repository&lt;br&gt;GEANT 22/72 real TMs" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;fillColor=#DCEBFA;strokeColor=#3F75B0;strokeWidth=1.4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="243.2" y="110.8" width="149.7" height="42.9" as="geometry"/></mxCell><mxCell id="8" value="Topology Zoo&lt;br&gt;Cogentco + gravity TMs" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;fillColor=#DCEBFA;strokeColor=#3F75B0;strokeWidth=1.4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="418.0" y="110.8" width="151.9" height="42.9" as="geometry"/></mxCell><mxCell id="9" value="Preprocessing&lt;br&gt;validation · Yen k=4 paths · normalisation&lt;br&gt;link–path bipartite graph · splits" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;fillColor=#DCEBFA;strokeColor=#3F75B0;strokeWidth=1.4;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="191.4" y="185.6" width="259.2" height="57.1" as="geometry"/></mxCell><mxCell id="10" value="Data pipeline details&lt;br&gt;•  topology validation, capacity units checked&lt;br&gt;•  Yen k = 4 min-hop candidate paths per OD pair&lt;br&gt;•  capacities and demands ÷ max link capacity&lt;br&gt;•  link–path bipartite graph (GNN input)&lt;br&gt;•  train / val / held-aside time splits; GEANT, Kdl unseen&lt;br&gt;•  calibrated load levels (LP-referenced MLU targets)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;fillColor=#FFFFFF;strokeColor=#8C8C8C;strokeWidth=1.2;fontSize=10.5;dashed=1;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="180.2" y="274.8" width="287.7" height="98.4" as="geometry"/></mxCell><mxCell id="11" value="VIRTUAL / DIGITAL-TWIN LAYER" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;fillColor=#A8DBB0;strokeColor=#2C6E37;strokeWidth=1.4;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="488.9" y="405.2" width="238.2" height="36.0" as="geometry"/></mxCell><mxCell id="12" value="5-member physics-anchored&lt;br&gt;ensemble twin" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;fillColor=#DDF1DF;strokeColor=#3F8E4C;strokeWidth=1.4;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="162.3" y="473.2" width="189.4" height="42.9" as="geometry"/></mxCell><mxCell id="13" value="Predicted link loads&lt;br&gt;mean μ and uncertainty σ" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;fillColor=#DDF1DF;strokeColor=#3F8E4C;strokeWidth=1.4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="376.5" y="473.2" width="160.9" height="42.9" as="geometry"/></mxCell><mxCell id="14" value="Conformal calibration&lt;br&gt;(validation only, c = 0.955)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;fillColor=#DDF1DF;strokeColor=#3F8E4C;strokeWidth=1.4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="562.7" y="473.2" width="164.7" height="42.9" as="geometry"/></mxCell><mxCell id="15" value="Twin details&lt;br&gt;•  path features: demand, split fraction, hop count&lt;br&gt;•  per-member MLP multiplier, initialised at physics (= 1)&lt;br&gt;•  loss: MSE + anchor penalty (multiplier − 1)²&lt;br&gt;•  μ = ensemble mean, σ = ensemble spread&lt;br&gt;•  calibrated so 2σ coverage ≥ 0.9 on validation" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;fillColor=#FFFFFF;strokeColor=#8C8C8C;strokeWidth=1.2;fontSize=10.5;dashed=1;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="284.0" y="548.1" width="289.9" height="86.4" as="geometry"/></mxCell><mxCell id="16" value="SERVICE / DECISION LAYER" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;fillColor=#F7C08A;strokeColor=#A85A0E;strokeWidth=1.4;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="659.4" y="666.5" width="211.2" height="36.0" as="geometry"/></mxCell><mxCell id="17" value="Graph RL policy&lt;br&gt;(TopoFlowNet-style GNN)&lt;br&gt;splits each demand over 4 paths" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;fillColor=#FDE3C8;strokeColor=#D27A1F;strokeWidth=1.4;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="658.8" y="734.5" width="210.4" height="57.1" as="geometry"/></mxCell><mxCell id="18" value="Safety gate&lt;br&gt;accept iff μ + kσ ≤ capacity&lt;br&gt;on every link (k = 1)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;fillColor=#FDE3C8;strokeColor=#D27A1F;strokeWidth=2.2;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="894.7" y="734.5" width="176.7" height="57.1" as="geometry"/></mxCell><mxCell id="19" value="Accept →&lt;br&gt;apply proposal" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;fillColor=#FDE3C8;strokeColor=#D27A1F;strokeWidth=1.4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1096.7" y="741.6" width="104.7" height="42.9" as="geometry"/></mxCell><mxCell id="20" value="Reject → fallback&lt;br&gt;last accepted · shortest · equal&lt;br&gt;(conditional LP, optional)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;fillColor=#FDE3C8;strokeColor=#D27A1F;strokeWidth=1.4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="672.0" y="844.3" width="187.9" height="57.1" as="geometry"/></mxCell><mxCell id="21" value="Decision details&lt;br&gt;•  GNN on the link–path bipartite graph&lt;br&gt;•  per-demand 4-way softmax split&lt;br&gt;•  gate: utilisation-space UCB, limit 1.0&lt;br&gt;•  optional relative-σ veto (off in frozen config)&lt;br&gt;•  fallback: feasible first, else least-violating&lt;br&gt;•  LP only if a forced-link lower bound ≤ 1" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;fillColor=#FFFFFF;strokeColor=#8C8C8C;strokeWidth=1.2;fontSize=10.5;dashed=1;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="884.7" y="823.6" width="242.7" height="98.4" as="geometry"/></mxCell><mxCell id="22" value="NETWORK  (flow-level simulator / physical proxy)&lt;br&gt;applies the routing and returns realised link loads" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;fillColor=#EEF1F4;strokeColor=#5B6B7A;strokeWidth=1.4;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="682.0" y="954.1" width="648.0" height="42.9" as="geometry"/></mxCell><mxCell id="23" value="Closed-loop safe decision testing" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;fillColor=#FFF1A8;strokeColor=#C99A06;strokeWidth=2;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1267.8" y="854.9" width="216.4" height="36.0" as="geometry"/></mxCell><mxCell id="24" value="" style="ed