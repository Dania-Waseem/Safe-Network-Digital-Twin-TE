ry"/></mxCell><mxCell id="31" value="scale c" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3C9A4B;fontColor=#3C9A4B;strokeWidth=1.6;endArrow=block;endFill=1;fontSize=10;fontFamily=Helvetica;" edge="1" parent="1" source="14" target="13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="32" value="μ, σ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3C9A4B;fontColor=#3C9A4B;strokeWidth=1.6;endArrow=block;endFill=1;fontSize=10;fontFamily=Helvetica;" edge="1" parent="1" source="13" target="18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="33" value="accept" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#E07B00;fontColor=#E07B00;strokeWidth=1.6;endArrow=block;endFill=1;fontSize=10;fontFamily=Helvetica;" edge="1" parent="1" source="18" target="19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="34" value="reject" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#E07B00;fontColor=#E07B00;strokeWidth=1.6;endArrow=block;endFill=1;fontSize=10;fontFamily=Helvetica;" edge="1" parent="1" source="18" target="20"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="35" value="applied action" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#E07B00;fontColor=#E07B00;strokeWidth=1.6;endArrow=block;endFill=1;fontSize=10;fontFamily=Helvetica;" edge="1" parent="1" source="19" target="22"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="36" value="applied action" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#E07B00;fontColor=#E07B00;strokeWidth=1.6;endArrow=block;endFill=1;fontSize=10;fontFamily=Helvetica;" edge="1" parent="1" source="20" target="22"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="37" value="realised loads / recalibration" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7E57C2;fontColor=#7E57C2;strokeWidth=1.6;endArrow=block;endFill=1;fontSize=10;fontFamily=Helvetic