s&lt;br&gt;•  mean ± SD over seeds&lt;br&gt;•  paired Wilcoxon, Holm correction, Cliff&amp;#x27;s δ&lt;br&gt;•  McNemar for paired accept/reject&lt;br&gt;•  Friedman + Nemenyi across topologies" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;fillColor=#FFFFFF;strokeColor=#8C8C8C;strokeWidth=1.2;fontSize=10.5;dashed=1;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="753.0" y="238.6" width="232.9" height="74.4" as="geometry"/></mxCell><mxCell id="21" value="Metrics&lt;br&gt;•  demand satisfaction (P1)&lt;br&gt;•  max link utilisation&lt;br&gt;•  violation rate&lt;br&gt;•  unsafe-accept, false-reject rates&lt;br&gt;•  generalization gap (seen − unseen)&lt;br&gt;•  decision time per component" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;fillColor=#FFFFFF;strokeColor=#8C8C8C;strokeWidth=1.2;fontSize=10.5;dashed=1;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="767.3" y="115.5" width="204.4" height="98.4" as="geometry"/></mxCell><mxCell id="22" value="METRICS &amp;amp; STATISTICS" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;fillColor=#A8DBB0;strokeColor=#2C6E37;strokeWidth=1.4;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="778.5" y="54.8" width="181.9" height="36.0" as="geometry"/></mxCell><mxCell id="23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2F6DB5;fontColor=#2F6DB5;strokeWidth=1.6;endArrow=block;endFill=1;fontSize=10;fontFamily=Helvetica;" edge="1" parent="1" source="8" target="14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#E07B00;fontColor=#E07B00;strokeWidth=1.6;endArrow=block;endFill=1;fontSize=10;fontFamily=Helvetica;" edge="1" parent="1" source="14" target="17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3C9A4B;fontColor=#3C9A4B;strokeWidth=1.