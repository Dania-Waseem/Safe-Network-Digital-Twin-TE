  "relu_theory": {
    "claim": "ReLU(F*) is the Euclidean projection of the unconstrained minimizer onto F>=0, but is NOT in general the minimizer of L over F>=0. The true constrained argmin solves KKT with complementary slackness; active-set / projected Newton required. P1 only names ReLU projection.",
    "when_equivalent": "If unconstrained F* >= 0 already, ReLU is exact.",
    "when_not": "If some F*_p < 0, ReLU(F*) generally differs from argmin_{F>=0} L."
  },
